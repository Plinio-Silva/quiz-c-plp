{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Compilar Quiz",
			"type": "shell",
			"command": "C:/msys64/ucrt64/bin/gcc",
			"args": [
				"-Wall",
				"-I.",
				"-Iinclude",
				"src/main.c",
				"src/interface.c",
				"src/temporizador.c",
				"src/perguntas.c",
				"conio.c",
				"-o",
				"build/quiz.exe"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": ["$gcc"]
		},
		{
			"label": "Rodar Quiz",
			"type": "shell",
			"command": "${workspaceFolder}/build/quiz.exe",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": "Compilar Quiz",
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}
